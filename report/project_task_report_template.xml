<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_project_task" model="ir.actions.report">
        <field name="name">Reporte de Tarea</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_task_report.report_task_body_template</field>
        <field name="report_file">project_task_report.report_task_body_template</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_task_body_template">
        <t t-call="web.html_container">
            <!-- 1. Itera sobre cada TAREA PRINCIPAL seleccionada -->
            <t t-foreach="docs" t-as="task">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="container">
                            <!-- Muestra el nombre del PROYECTO y la TAREA PRINCIPAL -->
                            <div class="row">
                                <div class="col-12">
                                    <h2>Proyecto: <span t-field="task.project_id.name"/></h2>
                                    <h1 class="mt-3">Tarea Principal: <span t-field="task.name"/></h1>
                                    <hr/>
                                </div>
                            </div>

                            <!-- 2. Itera sobre cada SUBTAREA de la tarea principal -->
                            <t t-foreach="task.child_ids" t-as="subtask">
                                <div class="subtask-block" style="margin-top: 20px; page-break-inside: avoid;">
                                    <!-- Nombre de la Subtarea -->
                                    <div class="row">
                                        <div class="col-12">
                                            <h3>Subtarea: <span t-field="subtask.name"/></h3>
                                        </div>
                                    </div>

                                    <!-- Descripción de la Subtarea -->
                                    <div class="row mt-2">
                                        <div class="col-12">
                                            <strong>Descripción:</strong>
                                            <p><span t-field="subtask.description"/></p>
                                        </div>
                                    </div>

                                    <!-- Evidencias de la Subtarea -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <strong>Evidencias Adjuntas:</strong>
                                            <!-- Llama a la función para obtener las imágenes de la SUBTAREA (límite 4 ya aplicado en python) -->
                                            <t t-set="images" t-value="subtask._get_attached_images()"/>
                                            <t t-if="not images">
                                                <p>No hay imágenes adjuntas para esta subtarea.</p>
                                            </t>
                                            <t t-if="images">
                                                <div class="row mt-2">
                                                    <t t-foreach="images" t-as="img">
                                                        <div class="col-6 text-center mb-3">
                                                            <!-- Llama a la función de rotación y construye el data URI -->
                                                            <img t-attf-src="data:image/png;base64,{{ task._get_rotated_image_b64(img) }}" style="max-width: 220px; max-height: 300px; border: 1px solid #ddd; object-fit: contain;"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                <hr style="margin-top: 20px;"/>
                            </t>

                             <t t-if="not task.child_ids">
                                <p>Esta tarea no tiene subtareas.</p>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
