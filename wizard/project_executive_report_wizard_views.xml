<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_executive_report_wizard_form" model="ir.ui.view">
        <field name="name">project.executive.report.wizard.form</field>
        <field name="model">project.executive.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Reporte Ejecutivo">
                <group>
                    <field name="project_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_generate_report" string="Generar Reporte" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_executive_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Ejecutivo</field>
        <field name="res_model">project.executive.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_project_executive_report"
              name="Reporte Ejecutivo"
              parent="project.menu_project_report"
              action="action_project_executive_report_wizard"
              sequence="20"/>
</odoo>
